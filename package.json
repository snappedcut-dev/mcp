{
  "name": "@snappedcut/mcp",
  "version": "0.2.0",
  "description": "MCP server exposing the Snapped Cut cloud render API to Claude and other MCP clients.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "snappedcut-mcp": "./src/server.mjs"
  },
  "main": "./src/server.mjs",
  "exports": {
    ".": "./src/server.mjs",
    "./tools": "./src/tools.mjs"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snappedcut-dev/mcp.git"
  },
  "homepage": "https://snappedcut.com/docs",
  "bugs": "https://github.com/snappedcut-dev/mcp/issues",
  "keywords": [
    "snappedcut",
    "mcp",
    "model-context-protocol",
    "claude",
    "video",
    "render"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@snappedcut/sdk": "^0.2.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
